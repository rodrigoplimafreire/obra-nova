# Copie para .env.local e preencha. .env.local não vai para o git.

# Projeto Supabase `obra-nova` (wnzdsqpsowxmistbnhca, região São Paulo).
NEXT_PUBLIC_SUPABASE_URL=https://wnzdsqpsowxmistbnhca.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca com prefixo NEXT_PUBLIC_. Só o servidor lê esta chave, e é ela que
# atende o mestre no canteiro e o cliente no relatório — os dois sem login.
# No painel do Supabase ela aparece como "secret key" (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do deploy, usada para montar os links que vão por WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quem pode entrar em /admin. Separado por vírgula.
# Vazia = painel trancado, com aviso explícito na tela de login.
ADMIN_EMAIL_ALLOWLIST=

# Transcrição do áudio, nos dois módulos: o relato do canteiro e o briefing do
# orçamento. Sem chave, o áudio continua sendo gravado e guardado; a
# transcrição fica marcada como falha, com o motivo no painel.
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# Opcional: sobrescreve o modelo padrão (whisper-large-v3-turbo na Groq,
# whisper-1 na OpenAI).
# TRANSCRIPTION_MODEL=

# Modelo que redige o relatório da semana e que formula as perguntas do
# orçamento. Barato serve nas duas: nenhuma das duas decide preço.
# ANALYSIS_MODEL=

# Modelo que monta a tabela de custos a partir do que foi falado. Aqui é
# dinheiro de cliente saindo de transcrição suja, e o erro caro é o número
# trocado — por isso um modelo forte, separado do de cima. Decisão da Fase 2.
# ANTHROPIC_API_KEY=
# ORCAMENTO_MODEL=
